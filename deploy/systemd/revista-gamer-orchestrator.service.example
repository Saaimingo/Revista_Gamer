[Unit]
Description=Revista Gamer Motor Editorial task scheduler and dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=revistagamer
Group=revistagamer
WorkingDirectory=/opt/revista-gamer
StateDirectory=revista-gamer
StateDirectoryMode=0700
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=XDG_DATA_HOME=/var/lib/revista-gamer/private
ExecStart=/opt/revista-gamer/.venv/bin/python -m motor_editorial --data-dir /var/lib/revista-gamer scheduler run --poll-seconds 2
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/revista-gamer
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
