--- /dev/null
+++ b/automation/pipeline/src/call_journal.py
@@ -0,0 +1,261 @@
+"""Small durable journal for non-idempotent external model calls."""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import threading
+from contextlib import contextmanager
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+from .errors import AdapterError, UncertainAdapterError
+
+
+def _sha256(value: bytes) -> str:
+    return hashlib.sha256(value).hexdigest()
+
+
+def _now() -> str:
+    return datetime.now(timezone.utc).isoformat(timespec="milliseconds")
+
+
+class DurableCallJournal:
+    """Persist a result before returning it; block repeats until a human authorizes one."""
+
+    def __init__(self, state_path: str | Path):
+        self.path = Path(state_path)
+        self.result_path = self.path.with_suffix(".response.txt")
+        self.partial_path = self.path.with_suffix(".partial.txt")
+        self.lock_path = self.path.with_suffix(self.path.suffix + ".lock")
+        self.active_path = self.path.with_suffix(self.path.suffix + ".active")
+        self._thread_lock = threading.RLock()
+        self._active_thread_lock = threading.Lock()
+
+    @contextmanager
+    def _locked(self):
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        fd = os.open(self.lock_path, os.O_CREAT | os.O_RDWR, 0o600)
+        locked = False
+        try:
+            with self._thread_lock:
+                if os.name == "nt":
+                    import msvcrt
+                    if os.fstat(fd).st_size == 0:
+                        os.write(fd, b"\0")
+                    os.lseek(fd, 0, os.SEEK_SET)
+                    msvcrt.locking(fd, msvcrt.LK_LOCK, 1)
+                else:
+                    import fcntl
+                    fcntl.flock(fd, fcntl.LOCK_EX)
+                locked = True
+                yield
+        finally:
+            if locked and os.name == "nt":
+                import msvcrt
+                os.lseek(fd, 0, os.SEEK_SET)
+                msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
+            elif locked:
+                import fcntl
+                fcntl.flock(fd, fcntl.LOCK_UN)
+            os.close(fd)
+
+    @contextmanager
+    def active_call(self, *, wait: bool = True):
+        """Hold a process lock for the full request so stale in-flight calls are detectable."""
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        fd = os.open(self.active_path, os.O_CREAT | os.O_RDWR, 0o600)
+        thread_locked = self._active_thread_lock.acquire(blocking=wait)
+        if not thread_locked:
+            os.close(fd)
+            raise AdapterError("a request with this call ID is still in progress")
+        locked = False
+        try:
+            if os.name == "nt":
+                import msvcrt
+                if os.fstat(fd).st_size == 0:
+                    os.write(fd, b"\0")
+                os.lseek(fd, 0, os.SEEK_SET)
+                mode = msvcrt.LK_LOCK if wait else msvcrt.LK_NBLCK
+                msvcrt.locking(fd, mode, 1)
+            else:
+                import fcntl
+                mode = fcntl.LOCK_EX if wait else fcntl.LOCK_EX | fcntl.LOCK_NB
+                fcntl.flock(fd, mode)
+            locked = True
+            yield
+        except OSError:
+            if not wait:
+                raise AdapterError("a request with this call ID is still in progress") from None
+            raise
+        finally:
+            if locked and os.name == "nt":
+                import msvcrt
+                os.lseek(fd, 0, os.SEEK_SET)
+                msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
+            elif locked:
+                import fcntl
+                fcntl.flock(fd, fcntl.LOCK_UN)
+            os.close(fd)
+            self._active_thread_lock.release()
+
+    def _write_text(self, path: Path, text: str) -> None:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        temp = path.with_name(path.name + ".tmp")
+        with temp.open("w", encoding="utf-8", newline="") as output:
+            output.write(text)
+            output.flush()
+            os.fsync(output.fileno())
+        os.replace(temp, path)
+
+    def _read_state(self) -> dict[str, Any] | None:
+        if not self.path.exists():
+            return None
+        try:
+            value = json.loads(self.path.read_text(encoding="utf-8"))
+        except (OSError, json.JSONDecodeError):
+            raise AdapterError("call checkpoint is unreadable; inspect it before any retry") from None
+        if not isinstance(value, dict):
+            raise AdapterError("call checkpoint has an invalid shape; inspect it before any retry")
+        return value
+
+    def _inspect_unlocked(self) -> tuple[dict[str, Any] | None, str | None]:
+        state = self._read_state()
+        if self.result_path.is_file():
+            if state is None:
+                raise AdapterError("saved result has no matching call checkpoint; inspect before any retry")
+            try:
+                text = self.result_path.read_text(encoding="utf-8")
+            except OSError:
+                raise AdapterError("saved call result cannot be read; do not retry") from None
+            digest = _sha256(text.encode("utf-8"))
+            if state and state.get("response_sha256") not in (None, digest):
+                raise AdapterError("saved call result hash does not match its checkpoint; do not retry")
+            if state.get("status") != "completed":
+                state = {**state, "status": "completed", "response_sha256": digest,
+                         "recovered_from_result_file": True, "completed_at": _now()}
+                self._write_state(state)
+            return state, text
+        if state and state.get("status") == "completed":
+            raise AdapterError("checkpoint says completed but its saved result is missing; do not retry")
+        return state, None
+
+    def inspect(self) -> tuple[dict[str, Any] | None, str | None]:
+        with self._locked():
+            return self._inspect_unlocked()
+
+    def _write_state(self, state: dict[str, Any]) -> None:
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        temp = self.path.with_name(self.path.name + ".tmp")
+        payload = json.dumps(state, ensure_ascii=False, sort_keys=True, indent=2)
+        with temp.open("w", encoding="utf-8", newline="") as output:
+            output.write(payload)
+            output.flush()
+            os.fsync(output.fileno())
+        os.replace(temp, self.path)
+
+    def begin(
+        self, *, call_id: str, model: str, fingerprint: str,
+        client_request_id: str | None = None, run_id: str | None = None,
+    ) -> str | None:
+        with self._locked():
+            state, text = self._inspect_unlocked()
+            if state:
+                if (state.get("call_id") != call_id
+                        or state.get("run_id", state.get("call_id")) != (run_id or call_id)
+                        or state.get("model") != model or state.get("fingerprint") != fingerprint):
+                    raise AdapterError("call checkpoint identity changed; inspect before retry")
+                if text is not None:
+                    return text
+                status = state.get("status")
+                if status == "retry_authorized":
+                    attempt = int(state.get("attempt", 1)) + 1
+                    state.update({"status": "in_flight", "attempt": attempt,
+                                  "started_at": _now(), "retry_authorized_at": state.get("retry_authorized_at")})
+                    self._append_request_id(state, attempt, client_request_id)
+                    self._write_state(state)
+                    return None
+                raise UncertainAdapterError(
+                    f"call {call_id} is {status or 'unknown'}; inspect its checkpoint and saved result before any retry")
+            state = {
+                "version": 1, "call_id": call_id, "run_id": run_id or call_id,
+                "model": model, "fingerprint": fingerprint,
+                "status": "in_flight", "attempt": 1, "started_at": _now(),
+            }
+            self._append_request_id(state, 1, client_request_id)
+            self._write_state(state)
+            return None
+
+    @staticmethod
+    def _append_request_id(state: dict[str, Any], attempt: int, request_id: str | None) -> None:
+        if not request_id:
+            return
+        attempts = list(state.get("request_attempts") or [])
+        attempts.append({"attempt": attempt, "client_request_id": request_id})
+        state["request_attempts"] = attempts
+        state["client_request_id"] = request_id
+
+    def record_response_diagnostics(self, diagnostics: dict[str, Any]) -> None:
+        with self._locked():
+            state = self._read_state() or {}
+            saved = dict(state.get("response_diagnostics") or {})
+            saved.update(diagnostics)
+            state["response_diagnostics"] = saved
+            self._write_state(state)
+
+    def completed(
+        self, text: str, *, response_id: str | None, usage: dict[str, Any] | None = None,
+    ) -> None:
+        with self._locked():
+            self._write_text(self.result_path, text)
+            state = self._read_state() or {}
+            state.update({
+                "status": "completed", "completed_at": _now(),
+                "response_sha256": _sha256(text.encode("utf-8")),
+                "response_id": response_id,
+                "result_path": str(self.result_path),
+            })
+            if usage:
+                state["usage"] = usage
+            self._write_state(state)
+
+    def uncertain(self, partial_text: str, *, error_code: str) -> None:
+        with self._locked():
+            state = self._read_state() or {}
+            if partial_text:
+                self._write_text(self.partial_path, partial_text)
+                state["partial_path"] = str(self.partial_path)
+                state["partial_sha256"] = _sha256(partial_text.encode("utf-8"))
+            state.update({"status": "uncertain", "updated_at": _now(), "error_code": error_code})
+            self._write_state(state)
+
+    def failed(self, *, error_code: str) -> None:
+        with self._locked():
+            state = self._read_state() or {}
+            state.update({"status": "provider_failed", "updated_at": _now(), "error_code": error_code})
+            self._write_state(state)
+
+    def authorize_retry(self, *, confirmed: bool = False) -> dict[str, Any]:
+        with self.active_call(wait=False):
+            with self._locked():
+                state, text = self._inspect_unlocked()
+                if text is not None:
+                    return {"authorized": False, "recoverable": True, "status": "completed",
+                            "result_path": str(self.result_path),
+                            "response_sha256": _sha256(text.encode("utf-8"))}
+                if not state:
+                    raise AdapterError("no previous call checkpoint exists")
+                if state.get("status") == "in_flight":
+                    state.update({"status": "uncertain", "error_code": "process_interrupted",
+                                  "updated_at": _now()})
+                if state.get("status") not in {"uncertain", "provider_failed"}:
+                    raise AdapterError(f"call state {state.get('status')} is not eligible for manual retry")
+                if not confirmed:
+                    raise AdapterError(
+                        "manual retry requires explicit confirmation; the prior request may have consumed usage")
+                state.update({"status": "retry_authorized", "retry_authorized_at": _now()})
+                self._write_state(state)
+                return {"authorized": True, "recoverable": False, "status": "retry_authorized",
+                        "attempt": int(state.get("attempt", 1)),
+                        "warning": "The provider may have processed the prior request; this retry may consume usage again."}
