+"""Stable UTF-8 settings for pipeline subprocess text streams on Windows."""
+import os
+
+
+def utf8_process_env() -> dict[str, str]:
+    """Return an environment that makes Python child stdout/stderr UTF-8."""
+    env = os.environ.copy()
+    env["PYTHONUTF8"] = "1"
+    env["PYTHONIOENCODING"] = "utf-8"
+    return env
