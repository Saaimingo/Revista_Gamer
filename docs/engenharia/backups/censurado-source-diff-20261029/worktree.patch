+                out[key] = Path(src["file"]).read_text(encoding="utf-8")
+            elif "persona_fragments" in src:
+                out[key] = load_persona_fragments(src["persona_fragments"])
+            elif "persona" in src:
+                out[key] = self._persona(inputs["author"])
+            elif "editorial" in src:
+                out[key] = self._editorial(src["editorial"])
+            elif "feeds" in src:
+                out[key] = self._feeds(inputs["author"], src["feeds"])
+            elif "websearch" in src:
+                out[key] = self._websearch(src["websearch"], outputs)
+            elif "topics" in src:
+                out[key] = self._topics()
+            elif "articles" in src:
+                out[key] = self._articles(src["articles"])
+        return out
