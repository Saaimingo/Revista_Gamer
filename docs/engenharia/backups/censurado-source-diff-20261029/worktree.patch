+
+
+class PipelineError(Exception):
+    exit_code = 1
+
+
+class ConfigError(PipelineError):
+    exit_code = 2
+
+
+class AdapterError(PipelineError):
+    exit_code = 4
+
+
+class UncertainAdapterError(AdapterError):
+    """The provider may have processed a request, but no terminal result was saved."""
+
+    code = "provider_outcome_uncertain"
+
+
+class PublishError(PipelineError):
+    exit_code = 5
