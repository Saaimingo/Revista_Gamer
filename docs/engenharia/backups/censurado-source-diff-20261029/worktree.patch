@@ -0,0 +1,495 @@
+"""Minimal Sign in with ChatGPT account support for the local SIWC adapter.
+
+The implementation follows OpenAI's documented open-source client flow. Tokens are
+kept outside the repository and protected with Windows DPAPI (or mode 0600 on POSIX).
+"""
+from __future__ import annotations
+
+import base64
+import ctypes
+import hashlib
+import hmac
+import json
+import os
+import secrets
+import sys
+import threading
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+import uuid
+import webbrowser
+from contextlib import contextmanager
+from dataclasses import dataclass
+from http.server import BaseHTTPRequestHandler, HTTPServer
+from pathlib import Path
+from typing import Any, Callable, Iterator, Mapping
+
+from .call_journal import DurableCallJournal
+
+
+ISSUER = "https://auth.openai.com"
+AUTHORIZATION_ENDPOINT = f"{ISSUER}/api/accounts/authorize"
+TOKEN_ENDPOINT = f"{ISSUER}/api/accounts/oauth/token"
+JWKS_URI = f"{ISSUER}/.well-known/jwks.json"
+API_BASE = "https://api.openai.com/v1"
+RESOURCE = API_BASE
+SCOPES = "openid profile email offline_access resource.invoke chatgpt.tokens.use.direct"
+DIRECT_USAGE_SCOPE = "chatgpt.tokens.use.direct"
+DYNAMIC_CLIENT_ID = "dynamic_agent_client"
+APP_NAME = "Censurado Web Brain"
+CALLBACK_PATH = "/auth/callback"
+
+
+class SIWCError(RuntimeError):
+    """Safe-to-display SIWC failure; never carries credential or response bodies."""
+
+
+@dataclass(frozen=True)
+class AuthorizationAttempt:
+    client_id: str
+    host_id: str
+    redirect_uri: str
+    state: str
+    nonce: str
+    verifier: str
+    challenge: str
+    new_registration: bool
+
+    def url(self) -> str:
+        query = {
+            "client_id": self.client_id,
+            "response_type": "code",
+            "redirect_uri": self.redirect_uri,
+            "scope": SCOPES,
+            "resource": RESOURCE,
+            "state": self.state,
+            "nonce": self.nonce,
+            "code_challenge_method": "S256",
+            "code_challenge": self.challenge,
+            "ext_agent_host_id": self.host_id,
+        }
+        if self.new_registration:
+            query["agent_name_hint"] = APP_NAME
+        return f"{AUTHORIZATION_ENDPOINT}?{urllib.parse.urlencode(query)}"
+
+
+def _dpapi(data: bytes, protect: bool) -> bytes:
+    if os.name != "nt":
+        raise SIWCError("platform_unsupported", "DPAPI só está disponível no Windows.")
+    from ctypes import wintypes
+
+    class DataBlob(ctypes.Structure):
+        _fields_ = [("cbData", wintypes.DWORD), ("pbData", ctypes.POINTER(ctypes.c_ubyte))]
+
+    source_buffer = ctypes.create_string_buffer(data)
+    source = DataBlob(len(data), ctypes.cast(source_buffer, ctypes.POINTER(ctypes.c_ubyte)))
+    output = DataBlob()
+    crypt32 = ctypes.windll.crypt32
+    if protect:
+        crypt32.CryptProtectData.argtypes = [
+            ctypes.POINTER(DataBlob), wintypes.LPCWSTR, ctypes.c_void_p, ctypes.c_void_p,
+            ctypes.c_void_p, wintypes.DWORD, ctypes.POINTER(DataBlob),
+        ]
+        crypt32.CryptProtectData.restype = wintypes.BOOL
+        ok = crypt32.CryptProtectData(
+            ctypes.byref(source), "Censurado SIWC", None, None, None, 1, ctypes.byref(output))
+    else:
+        crypt32.CryptUnprotectData.argtypes = [
+            ctypes.POINTER(DataBlob), ctypes.POINTER(wintypes.LPWSTR), ctypes.c_void_p,
+            ctypes.c_void_p, ctypes.c_void_p, wintypes.DWORD, ctypes.POINTER(DataBlob),
+        ]
+        crypt32.CryptUnprotectData.restype = wintypes.BOOL
+        ok = crypt32.CryptUnprotectData(
+            ctypes.byref(source), None, None, None, None, 1, ctypes.byref(output))
+    if not ok:
+        code = "dpapi_protect_failed" if protect else "dpapi_unprotect_failed"
+        raise SIWCError(code, "O Windows não conseguiu proteger ou abrir as credenciais locais.")
+    try:
+        return ctypes.string_at(output.pbData, output.cbData)
+    finally:
+        ctypes.windll.kernel32.LocalFree(output.pbData)
+
+
+class CredentialStore:
+    def __init__(self, path: Path | None = None):
+        if path is None:
+            if os.name == "nt":
+                root = os.environ.get("LOCALAPPDATA")
+                if not root:
+                    raise SIWCError("local_storage_unavailable", "LOCALAPPDATA não está definido.")
+                path = Path(root) / "CensuradoWebBrain" / "siwc-credentials.bin"
+            else:
+                root = os.environ.get("XDG_DATA_HOME")
+                path = (Path(root) if root else Path.home() / ".local" / "share") / "censurado" / "siwc-credentials.bin"
+        self.path = Path(path)
+        self.lock_path = self.path.with_suffix(self.path.suffix + ".lock")
+        self.host_path = self.path.with_name("siwc-host-id.txt")
+        self._thread_lock = threading.RLock()
+
+    @contextmanager
+    def lock(self) -> Iterator[None]:
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        if os.name == "posix":
+            self.path.parent.chmod(0o700)
+        fd = os.open(self.lock_path, os.O_CREAT | os.O_RDWR, 0o600)
+        locked = False
+        try:
+            with self._thread_lock:
+                if os.name == "nt":
+                    import msvcrt
+                    if os.fstat(fd).st_size == 0:
+                        os.write(fd, b"\0")
+                    os.lseek(fd, 0, os.SEEK_SET)
+                    msvcrt.locking(fd, msvcrt.LK_LOCK, 1)
+                else:
+                    import fcntl
+                    fcntl.flock(fd, fcntl.LOCK_EX)
+                locked = True
+                yield
+        finally:
+            if locked and os.name == "nt":
+                import msvcrt
+                os.lseek(fd, 0, os.SEEK_SET)
+                msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
+            elif locked:
+                import fcntl
+                fcntl.flock(fd, fcntl.LOCK_UN)
+            os.close(fd)
+
+    def _encode(self, raw: bytes) -> bytes:
+        if os.name == "nt":
+            return b"CWBSIWC1" + _dpapi(raw, True)
+        return b"CWBSIWCP" + raw
+
+    def _decode(self, raw: bytes) -> bytes:
+        if raw.startswith(b"CWBSIWC1") and os.name == "nt":
+            return _dpapi(raw[8:], False)
+        if raw.startswith(b"CWBSIWCP") and os.name != "nt":
+            return raw[8:]
+        raise SIWCError("credential_file_invalid", "Arquivo local de credenciais inválido.")
+
+    def load(self) -> dict[str, Any] | None:
+        if not self.path.exists():
+            return None
+        if os.name == "posix":
+            os.chmod(self.path, 0o600)
+        try:
+            value = json.loads(self._decode(self.path.read_bytes()).decode("utf-8"))
+        except SIWCError:
+            raise
+        except Exception:
+            raise SIWCError("credential_file_invalid", "Não foi possível ler as credenciais locais.") from None
+        if not isinstance(value, dict):
+            raise SIWCError("credential_file_invalid", "Registro local de credenciais inválido.")
+        return value
+
+    def save(self, record: Mapping[str, Any]) -> None:
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        if os.name == "posix":
+            self.path.parent.chmod(0o700)
+        content = json.dumps(dict(record), ensure_ascii=False, sort_keys=True).encode("utf-8")
+        temp = self.path.with_name(self.path.name + ".tmp")
+        fd = os.open(temp, os.O_CREAT | os.O_TRUNC | os.O_WRONLY, 0o600)
+        with os.fdopen(fd, "wb") as output:
+            output.write(self._encode(content))
+            output.flush()
+            os.fsync(output.fileno())
+        os.replace(temp, self.path)
+        if os.name == "posix":
+            os.chmod(self.path, 0o600)
+
+    def host_id(self) -> str:
+        self.host_path.parent.mkdir(parents=True, exist_ok=True)
+        if self.host_path.exists():
+            value = self.host_path.read_text(encoding="ascii").strip()
+            if value.startswith("urn:uuid:"):
+                uuid.UUID(value.removeprefix("urn:uuid:"))
+                return value
+            raise SIWCError("host_id_invalid", "Identificador local de host inválido.")
+        value = f"urn:uuid:{uuid.uuid4()}"
+        temp = self.host_path.with_name(self.host_path.name + ".tmp")
+        temp.write_text(value + "\n", encoding="ascii")
+        os.replace(temp, self.host_path)
+        return value
+
+
+class _CallbackHandler(BaseHTTPRequestHandler):
+    attempt: AuthorizationAttempt
+    result: dict[str, str] | None = None
+    event: threading.Event
+
+    def do_GET(self) -> None:  # noqa: N802
+        parsed = urllib.parse.urlparse(self.path)
+        params = urllib.parse.parse_qs(parsed.query)
+        state = params.get("state", [""])[0]
+        if parsed.path != CALLBACK_PATH or not hmac.compare_digest(state, self.attempt.state):
+            self.send_error(400)
+            return
+        type(self).result = {key: values[0] for key, values in params.items() if values}
+        type(self).event.set()
+        self.send_response(200)
+        self.send_header("Content-Type", "text/html; charset=utf-8")
+        self.end_headers()
+        self.wfile.write("<!doctype html><meta charset='utf-8'><p>Autorização recebida. Volte ao terminal.</p>".encode())
+
+    def log_message(self, format: str, *args: Any) -> None:
+        return  # OAuth callback query strings contain a short-lived authorization code.
+
+
+class _CallbackListener:
+    def __init__(self) -> None:
+        self.handler = type("SIWCCallbackHandler", (_CallbackHandler,), {})
+        self.handler.result = None
+        self.handler.event = threading.Event()
+        self.server = HTTPServer(("127.0.0.1", 0), self.handler)
+        self.server.timeout = 0.5
+        self.redirect_uri = f"http://127.0.0.1:{self.server.server_port}{CALLBACK_PATH}"
+
+    def wait(self, attempt: AuthorizationAttempt, timeout: int = 900) -> dict[str, str]:
+        self.handler.attempt = attempt
+        deadline = time.monotonic() + timeout
+        try:
+            while not self.handler.event.is_set() and time.monotonic() < deadline:
+                self.server.handle_request()
+        finally:
+            self.server.server_close()
+        result = self.handler.result
+        if result is None:
+            raise SIWCError("login_timeout", "O login não foi concluído dentro do tempo limite.")
+        if result.get("error"):
+            raise SIWCError("login_denied", "A autorização foi cancelada ou recusada no navegador.")
+        return result
+
+
+def _post_form(url: str, fields: Mapping[str, str]) -> dict[str, Any]:
+    request = urllib.request.Request(
+        url, data=urllib.parse.urlencode(dict(fields)).encode("ascii"),
+        headers={"Content-Type": "application/x-www-form-urlencoded"}, method="POST")
+    try:
+        with urllib.request.urlopen(request, timeout=30) as response:
+            result = json.loads(response.read().decode("utf-8"))
+    except urllib.error.HTTPError:
+        raise SIWCError("oauth_rejected", "O endpoint oficial de autenticação recusou a operação.") from None
+    except (urllib.error.URLError, TimeoutError, OSError):
+        raise SIWCError("oauth_network_error", "Não foi possível acessar o endpoint oficial de autenticação.") from None
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        raise SIWCError("oauth_invalid_response", "O endpoint oficial de autenticação retornou resposta inválida.") from None
+    if not isinstance(result, dict):
+        raise SIWCError("oauth_invalid_response", "O endpoint oficial de autenticação retornou resposta inválida.")
+    return result
+
+
+def _validate_id_token(token: str, client_id: str, nonce: str) -> dict[str, Any]:
+    try:
+        import jwt
+    except ImportError:
+        raise SIWCError("siwc_dependency_missing", "A validação OIDC requer PyJWT com suporte criptográfico no ambiente virtual.") from None
+    try:
+        header = jwt.get_unverified_header(token)
+        algorithm = header.get("alg")
+        if algorithm not in {"RS256", "ES256"}:
+            raise ValueError("unsupported algorithm")
+        key = jwt.PyJWKClient(JWKS_URI, timeout=15).get_signing_key_from_jwt(token).key
+        claims = jwt.decode(token, key=key, algorithms=[algorithm], audience=client_id,
+                            issuer=ISSUER, leeway=5,
+                            options={"require": ["exp", "iss", "aud", "sub", "nonce", "iat"]})
+        if not hmac.compare_digest(str(claims.get("nonce", "")), nonce):
+            raise ValueError("nonce mismatch")
+        return claims
+    except Exception as error:
+        raise SIWCError("id_token_invalid", f"O ID token não passou na validação ({type(error).__name__}).") from None
+
+
+def begin_login(store: CredentialStore, *, timeout: int = 900) -> dict[str, Any]:
+    host = store.host_id()
+    with store.lock():
+        previous = store.load()
+    new_registration = previous is None
+    client_id = DYNAMIC_CLIENT_ID if new_registration else str(previous["client_id"])
+    listener = _CallbackListener()
+    verifier = base64.urlsafe_b64encode(secrets.token_bytes(48)).decode("ascii").rstrip("=")
+    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode("ascii")).digest()).decode("ascii").rstrip("=")
+    attempt = AuthorizationAttempt(
+        client_id, host, listener.redirect_uri, secrets.token_urlsafe(32), secrets.token_urlsafe(32),
+        verifier, challenge, new_registration)
+    url = attempt.url()
+    # OpenAI authorization is initiated only by an explicit CLI login command.
+    try:
+        if not webbrowser.open(url):
+            raise SIWCError("browser_open_failed", "Não foi possível abrir o navegador do sistema.")
+        callback = listener.wait(attempt, timeout)
+    finally:
+        listener.server.server_close()
+    if not hmac.compare_digest(callback.get("state", ""), attempt.state):
+        raise SIWCError("oauth_state_invalid", "O retorno OAuth não corresponde à solicitação ativa.")
+    returned_id = callback.get("client_id") or client_id
+    if new_registration and (not returned_id or returned_id == DYNAMIC_CLIENT_ID):
+        raise SIWCError("client_registration_incomplete", "O cadastro OAuth não retornou o client ID emitido.")
+    if not new_registration and returned_id != client_id:
+        raise SIWCError("client_id_mismatch", "O client ID retornado não corresponde ao cadastro salvo.")
+    code = callback.get("code")
+    if not code:
+        raise SIWCError("authorization_code_missing", "O retorno OAuth não trouxe um código de autorização.")
+    result = _post_form(TOKEN_ENDPOINT, {
+        "grant_type": "authorization_code", "client_id": returned_id, "code": code,
+        "code_verifier": verifier, "redirect_uri": listener.redirect_uri, "resource": RESOURCE,
+    })
+    scopes = sorted(set(str(result.get("scope", "")).split()))
+    if DIRECT_USAGE_SCOPE not in scopes or "offline_access" not in scopes:
+        raise SIWCError("plan_scope_missing", "O consentimento não concedeu uso do plano e renovação da sessão.")
+    if str(result.get("token_type", "Bearer")).casefold() != "bearer":
+        raise SIWCError("token_type_invalid", "O endpoint OAuth não retornou um token bearer.")
+    id_token = str(result.get("id_token", ""))
+    if not id_token or not result.get("refresh_token") or not result.get("access_token"):
+        raise SIWCError("oauth_tokens_missing", "O consentimento não retornou os tokens esperados.")
+    claims = _validate_id_token(id_token, returned_id, attempt.nonce)
+    subject = str(claims.get("sub", ""))
+    if not subject or (previous and subject != previous.get("subject")):
+        raise SIWCError("account_mismatch", "A conta validada não corresponde ao cadastro local selecionado.")
+    record = {
+        "issuer": ISSUER, "subject": subject, "client_id": returned_id, "host_id": host,
+        "id_token": id_token, "access_token": str(result["access_token"]),
+        "refresh_token": str(result["refresh_token"]), "token_type": "Bearer",
+        "expires_at": int(time.time()) + int(result.get("expires_in", 3600)), "scopes": scopes,
+    }
+    with store.lock():
+        store.save(record)
+    return {"authenticated": True, "plan_usage_scope": True}
+
+
+class SIWCClient:
+    def __init__(self, store: CredentialStore, *, timeout: int = 60):
+        self.store = store
+        self.timeout = timeout
+
+    def _refresh(self, record: dict[str, Any]) -> dict[str, Any]:
+        payload = _post_form(TOKEN_ENDPOINT, {
+            "grant_type": "refresh_token", "client_id": record["client_id"],
+            "refresh_token": record["refresh_token"], "resource": RESOURCE,
+        })
+        if not payload.get("access_token"):
+            raise SIWCError("refresh_invalid_response", "A renovação OAuth não retornou um token válido.")
+        record["access_token"] = str(payload["access_token"])
+        record["refresh_token"] = str(payload.get("refresh_token") or record["refresh_token"])
+        record["expires_at"] = int(time.time()) + int(payload.get("expires_in", 3600))
+        if payload.get("scope"):
+            record["scopes"] = sorted(set(str(payload["scope"]).split()))
+        if DIRECT_USAGE_SCOPE not in record.get("scopes", []):
+            raise SIWCError("plan_scope_missing", "A renovação não preservou o escopo de uso do plano.")
+        return record
+
+    def access_token(self) -> str:
+        with self.store.lock():
+            record = self.store.load()
+            if not record:
+                raise SIWCError("login_required", "Execute o login SIWC local antes de chamar o modelo.")
+            if DIRECT_USAGE_SCOPE not in record.get("scopes", []):
+                raise SIWCError("plan_scope_missing", "A conta não autorizou uso do plano ChatGPT.")
+            if int(record.get("expires_at", 0)) <= int(time.time()) + 120:
+                record = self._refresh(record)
+                self.store.save(record)
+            return str(record["access_token"])
+
+    def models(self) -> list[dict[str, Any]]:
+        request = urllib.request.Request(
+            f"{API_BASE}/models", headers={"Authorization": f"Bearer {self.access_token()}"})
+        try:
+            with urllib.request.urlopen(request, timeout=self.timeout) as response:
+                data = json.loads(response.read().decode("utf-8"))
+        except Exception:
+            raise SIWCError("models_request_failed", "O catálogo SIWC não pôde ser consultado.") from None
+        rows = data.get("models") if isinstance(data, dict) else None
+        if not isinstance(rows, list):
+            raise SIWCError("models_invalid_response", "O catálogo SIWC retornou formato inesperado.")
+        return [row for row in rows if isinstance(row, dict) and row.get("visibility") == "list" and row.get("slug")]
+
+
+def require_catalog_model(
+    rows: list[dict[str, Any]], *, slug: str, display_name: str,
+) -> dict[str, Any]:
+    """Require the exact account-catalog model; never substitute a different slug."""
+    expected_label = "".join(char.casefold() for char in display_name if char.isalnum())
+    matches = [row for row in rows if row.get("slug") == slug]
+    if len(matches) != 1:
+        raise SIWCError("model_not_available", f"Requested SIWC model {display_name} is not available; no fallback was selected.")
+    actual_label = "".join(
+        char.casefold() for char in str(matches[0].get("display_name", "")) if char.isalnum())
+    if actual_label != expected_label:
+        raise SIWCError("model_catalog_mismatch", f"Catalog label does not match requested model {display_name}; no fallback was selected.")
+    return matches[0]
+
+
+def main(argv: list[str] | None = None) -> int:
+    import argparse
+
+    parser = argparse.ArgumentParser(description="Sign in with ChatGPT for the local Censurado adapter")
+    parser.add_argument("command", choices=("login", "status", "models", "inspect-call", "authorize-retry"))
+    parser.add_argument("--timeout", type=int, default=900)
+    parser.add_argument("--checkpoint")
+    parser.add_argument(
+        "--confirm", action="store_true",
+        help="explicitly accept that the provider may have processed the prior call and usage may be consumed again")
+    args = parser.parse_args(argv)
+    if args.command in {"inspect-call", "authorize-retry"}:
+        if not args.checkpoint:
+            parser.error(f"{args.command} requires --checkpoint")
+        journal = DurableCallJournal(args.checkpoint)
+        if args.command == "inspect-call":
+            state, result = journal.inspect()
+            if state is None:
+                print(json.dumps({"status": "missing"}))
+                return 2
+            print(json.dumps({
+                key: state.get(key) for key in (
+                    "call_id", "model", "status", "attempt", "started_at", "updated_at",
+                    "completed_at", "error_code", "response_sha256", "partial_sha256",
+                    "result_path", "partial_path", "recovered_from_result_file")
+                if state.get(key) is not None
+            }, ensure_ascii=False))
+            return 0
+        if not args.confirm:
+            parser.error("authorize-retry requires explicit --confirm after inspecting the checkpoint")
+        try:
+            result = journal.authorize_retry(confirmed=True)
+        except SIWCError as error:
+            print(json.dumps({"error": error.args[0]}, ensure_ascii=False))
+            return 2
+        except Exception as error:
+            print(json.dumps({"error": str(error)}, ensure_ascii=False))
+            return 2
+        print(json.dumps(result, ensure_ascii=False))
+        return 0 if result["authorized"] else 3
+
+    store = CredentialStore()
+    if args.command == "login":
+        result = begin_login(store, timeout=args.timeout)
+        print(json.dumps(result, ensure_ascii=False))
+        return 0
+    with store.lock():
+        record = store.load()
+    if args.command == "status":
+        print(json.dumps({
+            "connected": bool(record),
+            "plan_usage_authorized": bool(record and DIRECT_USAGE_SCOPE in record.get("scopes", [])),
+            "expires_at": record.get("expires_at") if record else None,
+        }, ensure_ascii=False))
+        return 0
+    if not record:
+        print(json.dumps({"error": "login_required"}))
+        return 2
+    try:
+        rows = SIWCClient(store).models()
+    except SIWCError as error:
+        print(json.dumps({"error": error.args[0]}))
+        return 2
+    print(json.dumps([
+        {"slug": row["slug"], "display_name": row.get("display_name", "")}
+        for row in rows
+    ], ensure_ascii=False))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
