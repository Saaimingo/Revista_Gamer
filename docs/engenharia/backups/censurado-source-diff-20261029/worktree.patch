+                    elif kind == "persona_fragments":
+                        if not isinstance(val, dict) or "persona" not in val:
+                            v.append(f"{ctag}.persona_fragments: persona file is required")
+                            continue
+                        if set(val) - {"persona", "beat", "research"}:
+                            v.append(f"{ctag}.persona_fragments: allowed files are persona, beat, research")
+                        for fragment, configured_paths in list(val.items()):
+                            was_list = isinstance(configured_paths, list)
+                            paths = configured_paths if was_list else [configured_paths]
+                            if (not paths or any(not isinstance(path, str) or not path for path in paths)):
+                                v.append(f"{ctag}.persona_fragments.{fragment}: file path or non-empty list required")
+                                continue
+                            resolved = []
+                            for fragment_path in paths:
+                                fp = (base / fragment_path).resolve()
+                                if not fp.is_file():
+                                    v.append(f"{ctag}.persona_fragments.{fragment}: not found: {fp}")
