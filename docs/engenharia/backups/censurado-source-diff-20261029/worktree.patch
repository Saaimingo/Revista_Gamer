@@ -0,0 +1,80 @@
+import json
+import unittest
+from unittest.mock import patch
+
+from src.adapter_api import ApiAdapter
+
+
+class _Stream:
+    status_code = 200
+    headers = {"content-type": "text/event-stream"}
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_):
+        return False
+
+    def iter_lines(self):
+        chunks = [
+            {"choices": [{"delta": {"reasoning": "internal only"}}]},
+            {"choices": [{"delta": {"content": "Resposta UTF-8: ação, GPU e Carranca."}}]},
+        ]
+        yield from ("data: " + json.dumps(item, ensure_ascii=False) for item in chunks)
+        yield "data: [DONE]"
+
+
+def _call(cfg):
+    with patch("src.adapter_api.httpx.stream", return_value=_Stream()) as request:
+        output = ApiAdapter(cfg).complete("prompt", want_json=False)
+    payload = request.call_args.kwargs["json"]
+    return output, payload
+
+
+class ApiAdapterReasoningTests(unittest.TestCase):
+    def test_ollama_legacy_think_false_maps_to_chat_completions_reasoning_effort_none(self):
+        output, payload = _call({
+            "base_url": "http://localhost:11434/v1",
+            "model": "qwen3.5:9b-q4_K_M",
+            "think": False,
+        })
+        self.assertEqual(payload["reasoning_effort"], "none")
+        self.assertNotIn("think", payload)
+        self.assertEqual(output, "Resposta UTF-8: ação, GPU e Carranca.")
+
+
+    def test_explicit_effort_wins_and_is_passed_through_without_provider_rewriting(self):
+        _, payload = _call({
+            "base_url": "http://localhost:11434/v1",
+            "model": "qwen3.5:9b-q4_K_M",
+            "reasoning_effort": "max",
+            "think": False,
+        })
+        self.assertEqual(payload["reasoning_effort"], "max")
+        self.assertNotIn("think", payload)
+
+
+    def test_generic_provider_keeps_reasoning_effort_and_legacy_extension_separate(self):
+        _, payload = _call({
+            "base_url": "https://api.deepseek.com/v1",
+            "provider": "deepseek",
+            "model": "test-model",
+            "reasoning_effort": "high",
+            "think": False,
+        })
+        self.assertEqual(payload["reasoning_effort"], "high")
+        self.assertNotIn("think", payload)
+
+
+    def test_ollama_think_true_does_not_invent_a_model_effort_level(self):
+        _, payload = _call({
+            "base_url": "http://127.0.0.1:11434/v1",
+            "model": "qwen3.5:9b-q4_K_M",
+            "think": True,
+        })
+        self.assertNotIn("think", payload)
+        self.assertNotIn("reasoning_effort", payload)
+
+
+if __name__ == "__main__":
+    unittest.main()
