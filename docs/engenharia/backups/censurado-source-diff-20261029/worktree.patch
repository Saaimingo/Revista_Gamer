+"""Load immutable persona prompt fragments and compose them for a pipeline node.
+
+The layout follows the useful Umbruch pattern: identity, beat, and research
+guidance are separate UTF-8 Markdown inputs and are composed at runtime. Each
+fragment may name one file or an ordered list of files. Source documents are
+read as-is and are never rewritten or normalized.
+"""
+from pathlib import Path
+
+from .errors import ConfigError
+
+_FRAGMENTS = (
+    ("persona", "Voz e identidade"),
+    ("beat", "Cobertura"),
+    ("research", "Pesquisa"),
+)
+
+
+def load_persona_fragments(files: dict[str, str | list[str]]) -> str:
+    """Read configured UTF-8 persona files and join them in declared order."""
+    sections = []
+    for key, heading in _FRAGMENTS:
+        configured = files.get(key)
+        if configured is None:
+            continue
+        paths = [configured] if isinstance(configured, str) else configured
+        if not isinstance(paths, list) or not paths or any(
+            not isinstance(path, str) or not path for path in paths
+        ):
+            raise ConfigError(f"persona {key} must be a path or non-empty path list")
+        for path in paths:
+            try:
+                with Path(path).open("r", encoding="utf-8", newline="") as source:
+                    text = source.read()
+            except (OSError, UnicodeError) as exc:
+                raise ConfigError(f"persona {key} file cannot be read as UTF-8: {path}: {exc}") from exc
+            if not text.strip():
+                raise ConfigError(f"persona {key} file is empty: {path}")
+            sections.append(f"## {heading}\\n\\n{text}")
+    if not sections:
+        raise ConfigError("persona_fragments requires a persona file")
+    return "\\n\\n".join(sections)
