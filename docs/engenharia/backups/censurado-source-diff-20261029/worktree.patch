+"""Censurado adapter for the documented ChatGPT plan usage Responses API flow."""
+import json
+import hashlib
+import re
+import uuid
+from collections.abc import Callable
+from itertools import chain
+from pathlib import Path
+
+import httpx
+
+from .adapter_api import _looping
+from .call_journal import DurableCallJournal
+from .errors import AdapterError, UncertainAdapterError
+from .siwc_auth import API_BASE, CredentialStore, SIWCClient, SIWCError
+
+_DIAGNOSTIC_BODY_LIMIT = 2048
+_SSE_PROBE_LIMIT = 8192
+_SSE_PROBE_CHUNK_SIZE = 1024
+_SSE_LINE_LIMIT = 1024 * 1024
+_SSE_INITIAL_TYPES = {"response.created", "response.in_progress"}
+_SENSITIVE_KEYS = {
+    "accesstoken", "refreshtoken", "idtoken", "token", "authorization",
+    "apikey", "clientsecret", "secret", "password", "codeverifier", "authorizationcode",
+}
+
+
+def _sanitize_text(value: str) -> str:
+    value = re.sub(r"(?i)\bBearer\s+[A-Za-z0-9._~+/-]+=*", "Bearer [REDACTED]", value)
+    value = re.sub(
+        r"\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\b",
+        "[REDACTED_JWT]", value)
+    value = re.sub(
+        r"(?i)([\"']?(?:access[_-]?token|refresh[_-]?token|id[_-]?token|token|authorization|api[_-]?key|client[_-]?secret|password|secret|code[_-]?verifier|authorization[_-]?code)[\"']?)\s*[:=]\s*[\"']?[^\"'\s,;}&]+",
+        r"\1=[REDACTED]", value)
+    value = re.sub(r"(?i)([?&](?:code|token|access_token|refresh_token|key)=)[^&\s]+", r"\1[REDACTED]", value)
+    return re.sub(r"\b[A-Za-z0-9_-]{48,}\b", "[REDACTED_LONG_VALUE]", value)
+
+
+def _sanitize_json(value):
+    if isinstance(value, dict):
+        safe = {}
+        for key, item in value.items():
+            normalized_key = "".join(char.casefold() for char in str(key) if char.isalnum())
+            if normalized_key in _SENSITIVE_KEYS:
+                safe[str(key)] = "[REDACTED]"
+            else:
+                safe[str(key)] = _sanitize_json(item)
+        return safe
+    if isinstance(value, list):
+        return [_sanitize_json(item) for item in value]
+    if isinstance(value, str):
+        return _sanitize_text(value)
+    return value
+
+
+def _sanitize_diagnostic_body(raw: bytes) -> tuple[str, bool]:
+    truncated = len(raw) >= _DIAGNOSTIC_BODY_LIMIT
+    text = raw[:_DIAGNOSTIC_BODY_LIMIT].decode("utf-8", errors="replace")
+    try:
+        text = json.dumps(_sanitize_json(json.loads(text)), ensure_ascii=False, separators=(",", ":"))
+    except (ValueError, TypeError):
+        text = _sanitize_text(text)
+    encoded = text.encode("utf-8")
+    if len(encoded) > _DIAGNOSTIC_BODY_LIMIT:
+        text = encoded[:_DIAGNOSTIC_BODY_LIMIT].decode("utf-8", errors="ignore")
+        truncated = True
+    return text, truncated
+
+
+def _bounded_response_body(response, *, prefix: bytes = b"", chunks=None) -> dict:
+    raw = bytearray(prefix[:_DIAGNOSTIC_BODY_LIMIT])
+    truncated = len(prefix) > _DIAGNOSTIC_BODY_LIMIT
+    read_error = None
+    try:
+        remaining_chunks = chunks if chunks is not None else response.iter_bytes()
+        for chunk in remaining_chunks:
+            remaining = _DIAGNOSTIC_BODY_LIMIT - len(raw)
+            if remaining <= 0:
+                truncated = True
+                break
+            raw.extend(chunk[:remaining])
+            if len(chunk) > remaining or len(raw) >= _DIAGNOSTIC_BODY_LIMIT:
+                truncated = True
+                break
+    except Exception as error:  # diagnostics must not hide the original transport failure
+        read_error = type(error).__name__
+    body, sanitized_truncation = _sanitize_diagnostic_body(bytes(raw))
+    return {
+        "diagnostic_body": body,
+        "diagnostic_body_bytes": len(raw),
+        "diagnostic_body_truncated": truncated or sanitized_truncation,
+        **({"diagnostic_body_read_error": read_error} if read_error else {}),
+    }
+
+
+def _safe_header(headers, key: str, limit: int = 200) -> str | None:
+    value = headers.get(key)
+    if value is None:
+        return None
+    return "".join(char for char in str(value) if ord(char) >= 32 and ord(char) != 127)[:limit]
+
+
+def _response_metadata(response, client_request_id: str) -> dict:
+    headers = response.headers
+    return {
+        "http_status": int(response.status_code),
+        "content_type": _safe_header(headers, "content-type"),
+        "request_id": _safe_header(headers, "x-request-id") or _safe_header(headers, "openai-request-id"),
+        "client_request_id": client_request_id,
+        "server": _safe_header(headers, "server"),
+        "via": _safe_header(headers, "via"),
+        "cf_ray": _safe_header(headers, "cf-ray"),
+        "openai_processing_ms": _safe_header(headers, "openai-processing-ms"),
+    }
+
+
+def _parse_initial_sse_event(prefix: bytes) -> bool | None:
+    """Return True for a Responses lifecycle event, False for invalid SSE, None if incomplete."""
+    try:
+        text = prefix.decode("utf-8", errors="strict").replace("\r\n", "\n").replace("\r", "\n")
+    except UnicodeDecodeError:
+        return False
+    if text.startswith("\ufeff"):
+        text = text[1:]
+    blocks = text.split("\n\n")
+    for block in blocks[:-1]:
+        event_name = None
+        data_lines = []
+        for line in block.split("\n"):
+            if not line or line.startswith(":"):
+                continue
+            field, separator, value = line.partition(":")
+            if separator and value.startswith(" "):
+                value = value[1:]
+            if field == "event":
+                event_name = value
+            elif field == "data":
+                data_lines.append(value)
+            elif field not in {"id", "retry"}:
+                return False
+        if not data_lines:
+            if event_name:
+                return False
+            continue
+        try:
+            payload = json.loads("\n".join(data_lines))
+        except ValueError:
+            return False
+        if not isinstance(payload, dict):
+            return False
+        event_type = payload.get("type")
+        if event_type not in _SSE_INITIAL_TYPES or (event_name and event_name != event_type):
+            return False
+        response = payload.get("response")
+        if not isinstance(response, dict) or not isinstance(response.get("id"), str) or not response.get("id"):
+            return False
+        if response.get("status") not in {"in_progress", "queued"}:
+            return False
+        return True
+
+    leading = text.lstrip(" \t\r\n\ufeff").encode("utf-8")
+    possible_prefixes = (b"event:", b"data:", b":")
+    if leading and not any(candidate.startswith(leading) or leading.startswith(candidate)
+                           for candidate in possible_prefixes):
+        return False
+    return None
+
+
+def _probe_missing_content_type(response) -> tuple[bool, bytes, object, str]:
+    """Read a bounded prefix, validating one complete Responses SSE lifecycle event."""
+    remaining = iter(response.iter_bytes(chunk_size=_SSE_PROBE_CHUNK_SIZE))
+    prefix = bytearray()
+    reason = "prefix_limit_exceeded"
+    while len(prefix) < _SSE_PROBE_LIMIT:
+        try:
+            chunk = next(remaining)
+        except StopIteration:
+            return False, bytes(prefix), remaining, "stream_ended_before_valid_event"
+        capacity = _SSE_PROBE_LIMIT - len(prefix)
+        prefix.extend(chunk[:capacity])
+        if len(chunk) > capacity:
+            remaining = iter(chain((chunk[capacity:],), remaining))
+        verdict = _parse_initial_sse_event(bytes(prefix))
+        if verdict is True:
+            return True, bytes(prefix), remaining, "responses_sse_event_validated"
+        if verdict is False:
+            reason = "invalid_sse_prefix"
+            return False, bytes(prefix), remaining, reason
+    return False, bytes(prefix), remaining, reason
+
+
+class _SSELineTooLarge(ValueError):
+    pass
+
+
+def _iter_sse_lines(prefix: bytes, remaining_chunks):
+    """Incrementally yield SSE lines after a validated prefix, with a per-line memory cap."""
+    line = bytearray()
+    pending_cr = False
+    for chunk in chain((prefix,), remaining_chunks):
+        for byte in chunk:
+            if pending_cr:
+                pending_cr = False
+                yield line.decode("utf-8", errors="replace")
+                line.clear()
+                if byte == 10:
+                    continue
+            if byte == 13:
+                pending_cr = True
+            elif byte == 10:
+                yield line.decode("utf-8", errors="replace")
+                line.clear()
+            else:
+                line.append(byte)
+                if len(line) > _SSE_LINE_LIMIT:
+                    raise _SSELineTooLarge("SSE line exceeds the configured memory bound")
+    if pending_cr or line:
+        yield line.decode("utf-8", errors="replace")
+
+
+class ResponsesAdapter:
+    """Responses transport with an injectable token source for isolated tests."""
+
+    def __init__(self, cfg: dict, token_provider: Callable[[], str], *, base_url: str = API_BASE):
+        self.base = base_url.rstrip("/")
+        self.model = cfg["model"]
+        self.system = cfg.get("system")
+        self.timeout = cfg.get("timeout_s", 300)
+        self.reasoning_effort = cfg.get("reasoning_effort")
+        self.token_provider = token_provider
+        checkpoint_path = cfg.get("call_checkpoint_path")
+        if not checkpoint_path:
+            raise AdapterError("SIWC requires a durable call checkpoint path")
+        self.call_id = str(cfg.get("call_id") or Path(checkpoint_path).stem)
+        self.run_id = str(cfg.get("run_id") or self.call_id)
+        self.journal = DurableCallJournal(checkpoint_path)
+
+    def complete(self, prompt: str, want_json: bool, images: list[str] | None = None) -> str:
+        if want_json:
+            prompt = "Return one valid JSON object only, without markdown.\n\n" + prompt
+        content = [{"type": "input_text", "text": prompt}]
+        content.extend({"type": "input_image", "image_url": image} for image in (images or []))
+        payload: dict = {
+            "model": self.model,
+            "input": [{"role": "user", "content": content}],
+            "store": False,
+            "stream": True,
+        }
+        if self.system:
+            payload["instructions"] = self.system
+        if self.reasoning_effort is not None:
+            payload["reasoning"] = {"effort": self.reasoning_effort}
+        # The SIWC implementation in PR #44 relies on prompt-level JSON and local
+        # parsing. Keep that documented, conservative behavior; the plan-usage
+        # preview doesn't explicitly promise JSON-mode enforcement.
+
+        fingerprint = hashlib.sha256(
+            json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+        ).hexdigest()
+
+        with self.journal.active_call():
+            return self._complete_payload(payload, fingerprint)
+
+    def _complete_payload(self, payload: dict, fingerprint: str) -> str:
+        previous, recovered = self.journal.inspect()
+        if previous and (
+            previous.get("call_id") != self.call_id
+            or previous.get("model") != self.model
+            or previous.get("fingerprint") != fingerprint
+        ):
+            raise AdapterError("call checkpoint identity changed; inspect before retry")
+        if recovered is not None:
+            return recovered
+        if previous and previous.get("status") != "retry_authorized":
+            raise UncertainAdapterError(
+                f"call {self.call_id} is {previous.get('status')}; inspect its checkpoint and saved result before any retry")
+
+        try:
+            token = self.token_provider()
+        except SIWCError as error:
+            raise AdapterError(str(error)) from error
+        client_request_id = str(uuid.uuid4())
+        recovered = self.journal.begin(
+            call_id=self.call_id, model=self.model, fingerprint=fingerprint,
+            client_request_id=client_request_id, run_id=self.run_id)
+        if recovered is not None:
+            return recovered
+
+        parts: list[str] = []
+        try:
+            headers = {
+                "Authorization": f"Bearer {token}",
+                "Accept": "text/event-stream",
+                "Content-Type": "application/json",
+                "X-Client-Request-Id": client_request_id,
+            }
+            with httpx.stream("POST", f"{self.base}/responses", json=payload,
+                              headers=headers, timeout=self.timeout, follow_redirects=False) as response:
+                diagnostics = _response_metadata(response, client_request_id)
+                self.journal.record_response_diagnostics(diagnostics)
+                if response.status_code != 200:
+                    diagnostics.update(_bounded_response_body(response))
+                    self.journal.record_response_diagnostics(diagnostics)
+                    if response.status_code >= 500:
+                        self.journal.uncertain("", error_code=f"http_{response.status_code}")
+                        raise UncertainAdapterError(
+                            f"SIWC returned HTTP {response.status_code}; provider outcome is uncertain")
+                    self.journal.failed(error_code=f"http_{response.status_code}")
+                    raise AdapterError(f"SIWC Responses API returned HTTP {response.status_code}")
+                content_type = response.headers.get("content-type")
+                media_type = content_type.split(";", 1)[0].strip().casefold() if content_type else ""
+                if media_type == "text/event-stream":
+                    line_iter = response.iter_lines()
+                elif not media_type:
+                    valid_sse, prefix, remaining_chunks, probe_reason = _probe_missing_content_type(response)
+                    diagnostics.update({
+                        "sse_probe_valid": valid_sse,
+                        "sse_probe_bytes": len(prefix),
+                        "sse_probe_reason": probe_reason,
+                    })
+                    if not valid_sse:
+                        diagnostics.update(_bounded_response_body(
+                            response, prefix=prefix, chunks=remaining_chunks))
+                        self.journal.record_response_diagnostics(diagnostics)
+                        self.journal.uncertain("", error_code="unrecognized_sse_body")
+                        raise UncertainAdapterError(
+                            "SIWC response without Content-Type did not begin with valid Responses SSE")
+                    diagnostics["content_type_fallback"] = "validated_responses_sse_prefix"
+                    self.journal.record_response_diagnostics(diagnostics)
+                    line_iter = _iter_sse_lines(prefix, remaining_chunks)
+                else:
+                    diagnostics.update(_bounded_response_body(response))
+                    self.journal.record_response_diagnostics(diagnostics)
+                    self.journal.uncertain("", error_code="unexpected_content_type")
+                    raise UncertainAdapterError("SIWC returned a non-SSE Content-Type; provider outcome is uncertain")
+                for line in line_iter:
+                    if not line.startswith("data:"):
+                        continue
+                    data = line[5:].strip()
+                    if not data or data == "[DONE]":
+                        continue
+                    try:
+                        event = json.loads(data)
+                    except ValueError:
+                        self.journal.uncertain("".join(parts), error_code="invalid_event_json")
+                        raise UncertainAdapterError("SIWC stream event was invalid; provider outcome is uncertain") from None
+                    event_type = event.get("type")
+                    if event_type == "response.output_text.delta":
+                        parts.append(str(event.get("delta") or ""))
+                        if _looping("".join(parts)):
+                            self.journal.uncertain("".join(parts), error_code="output_loop")
+                            raise UncertainAdapterError("SIWC stream was stopped; provider outcome is uncertain")
+                    elif event_type == "response.failed":
+                        err = (event.get("response") or {}).get("error") or {}
+                        code = str(err.get("code") or "response_failed")
+                        self.journal.failed(error_code=code)
+                        raise AdapterError(f"SIWC Responses API failed ({code})")
+                    elif event_type == "response.incomplete":
+                        self.journal.uncertain("".join(parts), error_code="response_incomplete")
+                        raise UncertainAdapterError("SIWC response was incomplete; inspect before any retry")
+                    elif event_type == "response.completed":
+                        text = "".join(parts)
+                        completed = event.get("response") or {}
+                        response_id = completed.get("id") if isinstance(completed, dict) else None
+                        raw_usage = completed.get("usage") if isinstance(completed, dict) else None
+                        usage = {}
+                        if isinstance(raw_usage, dict):
+                            for key in ("input_tokens", "output_tokens", "total_tokens"):
+                                value = raw_usage.get(key)
+                                if isinstance(value, int) and not isinstance(value, bool):
+                                    usage[key] = value
+                        self.journal.completed(text, response_id=response_id, usage=usage or None)
+                        return text
+            self.journal.uncertain("".join(parts), error_code="stream_ended_before_completed")
+            raise UncertainAdapterError("SIWC stream ended without response.completed; inspect before any retry")
+        except UncertainAdapterError:
+            raise
+        except _SSELineTooLarge:
+            self.journal.uncertain("".join(parts), error_code="sse_line_too_large")
+            raise UncertainAdapterError(
+                "SIWC SSE line exceeded the local memory bound; provider outcome is uncertain") from None
+        except httpx.HTTPError as error:
+            self.journal.uncertain("".join(parts), error_code=type(error).__name__)
+            raise UncertainAdapterError(
+                f"SIWC connection ended ({type(error).__name__}); provider outcome is uncertain") from None
+
+
+class SIWCAdapter:
+    """Editorial adapter backed by the Censurado-specific DPAPI credential store."""
+
+    def __init__(self, cfg: dict):
+        for key in ("api_key", "api_key_env", "temperature", "max_tokens", "think"):
+            if cfg.get(key) is not None:
+                raise AdapterError(f"SIWC does not support adapter setting: {key}")
+        if cfg.get("base_url") not in (None, API_BASE, API_BASE.rstrip("/")):
+            raise AdapterError("SIWC uses only the official OpenAI API base URL")
+        self.client = SIWCClient(CredentialStore(), timeout=cfg.get("timeout_s", 300))
+        self.transport = ResponsesAdapter(cfg, self.client.access_token, base_url=API_BASE)
+
+    def complete(self, prompt: str, want_json: bool, images: list[str] | None = None) -> str:
+        return self.transport.complete(prompt, want_json, images)
