@@ -0,0 +1,121 @@
+"""Prepare a local-only preview using The Machine Herald's article/provenance shape.
+
+This deliberately does not create a signed submission or invoke the publication
+pipeline. It adapts a Censurado preview while preserving its source URLs and body.
+"""
+from datetime import datetime, timezone
+import hashlib
+import json
+from pathlib import Path
+from urllib.parse import urlsplit
+
+from .errors import AdapterError
+
+_CATEGORIES = {"Briefing", "Analysis", "News"}
+
+
+def _quoted(value: str) -> str:
+    # JSON double-quoted strings are valid YAML scalars and safely escape content.
+    return json.dumps(value, ensure_ascii=False)
+
+
+def _frontmatter(article: dict, provenance_id: str, timestamp: str) -> str:
+    lines = [
+        "---",
+        f"title: {_quoted(article['title'])}",
+        f"date: {_quoted(timestamp)}",
+        f"category: {_quoted(article['category'])}",
+        f"summary: {_quoted(article['summary'])}",
+        "tags:",
+        *[f"  - {_quoted(tag)}" for tag in article["tags"]],
+        "sources:",
+        *[f"  - {_quoted(url)}" for url in article["sources"]],
+        f"provenance_id: {_quoted(provenance_id)}",
+        "draft: true",
+        "---",
+        "",
+    ]
+    return "\n".join(lines)
+
+
+def prepare_preview(piece: dict, *, category: str, tags: list[str],
+                    sources: list[str], created_at: str | None = None) -> dict:
+    """Map a Censurado piece into a Machine Herald-shaped local preview package."""
+    if not isinstance(piece, dict):
+        raise AdapterError("Machine Herald preview needs a Censurado piece object")
+    title = piece.get("title")
+    summary = piece.get("summary") or piece.get("standfirst")
+    body = piece.get("body_markdown") or piece.get("body")
+    if not isinstance(title, str) or not title.strip():
+        raise AdapterError("Machine Herald preview requires piece.title")
+    if category not in _CATEGORIES:
+        raise AdapterError(f"Machine Herald category must be one of {sorted(_CATEGORIES)}")
+    if not isinstance(summary, str) or not 10 <= len(summary.strip()) <= 300:
+        raise AdapterError("Machine Herald summary must contain 10-300 characters")
+    if not isinstance(body, str) or len(body.strip()) < 100:
+        raise AdapterError("Machine Herald body_markdown must contain at least 100 characters")
+    if not isinstance(tags, list) or not tags or any(not isinstance(t, str) or not t.strip() for t in tags):
+        raise AdapterError("Machine Herald preview requires at least one non-empty tag")
+    if not isinstance(sources, list) or len(sources) < 2:
+        raise AdapterError("Machine Herald preview requires at least two HTTPS source URLs")
+    if any(not isinstance(source, str) for source in sources):
+        raise AdapterError("Machine Herald source URLs must be strings")
+    for source in sources:
+        try:
+            parsed = urlsplit(source)
+        except (TypeError, ValueError) as exc:
+            raise AdapterError("Machine Herald source URL is invalid") from exc
+        if parsed.scheme != "https" or not parsed.hostname:
+            raise AdapterError("Machine Herald source URLs must be HTTPS")
+    if len(set(sources)) != len(sources):
+        raise AdapterError("Machine Herald preview source URLs must be unique")
+
+    timestamp = created_at or datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
+    article = {
+        "title": title,
+        "category": category,
+        "summary": summary,
+        "tags": list(tags),
+        "sources": list(sources),
+        "body_markdown": body,
+    }
+    canonical = json.dumps(article, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+    preview_id = hashlib.sha256(canonical.encode("utf-8")).hexdigest()[:16]
+    markdown = _frontmatter(article, f"preview-{preview_id}", timestamp) + body
+    article_hash = hashlib.sha256(markdown.encode("utf-8")).hexdigest()
+    return {
+        "status": "preview_only",
+        "publication_ready": False,
+        "blockers": [
+            "no registered Machine Herald contributor identity/signature",
+            "human editorial approval and maintainer merge have not occurred",
+        ],
+        "article": article,
+        "markdown": markdown,
+        "provenance_preview": {
+            "article_sha256": article_hash,
+            "sources": list(sources),
+            "created_at": timestamp,
+            "contributor_signature": "not generated for local preview",
+            "publisher_signature": "not generated for local preview",
+        },
+    }
+
+
+def write_preview(package: dict, output_dir: str | Path) -> dict[str, str]:
+    """Write Markdown and provenance preview files locally as UTF-8."""
+    output = Path(output_dir)
+    output.mkdir(parents=True, exist_ok=True)
+    article_path = output / "article.preview.md"
+    provenance_path = output / "provenance.preview.json"
+    package_path = output / "preview.package.json"
+    with article_path.open("w", encoding="utf-8", newline="\n") as output:
+        output.write(package["markdown"])
+    with provenance_path.open("w", encoding="utf-8", newline="\n") as output:
+        output.write(json.dumps(package["provenance_preview"], ensure_ascii=False, indent=2))
+    with package_path.open("w", encoding="utf-8", newline="\n") as output:
+        output.write(json.dumps(
+            {key: value for key, value in package.items() if key != "markdown"},
+            ensure_ascii=False, indent=2))
+    return {"article": str(article_path), "provenance": str(provenance_path),
+            "package": str(package_path)}
